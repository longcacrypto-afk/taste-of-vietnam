{
  "name": "hom-nay-an-gi-taste-of-vietnam",
  "version": "0.2.0",
  "description": "Hôm nay ăn gì · Taste of Vietnam v0.2 — AI-Powered Vietnamese Food Discovery Platform (Full-Stack 20 Modules + 99-Screen UI Studio + Flutter Mobile)",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "build:ui": "node ui-design/build.js",
    "db:migrate": "node src/db/migrate.js",
    "test:db": "node --test --test-concurrency=1 tests/postgres/*.test.js",
    "db:migrate:status": "node src/db/migrate.js --status",
    "db:seed": "node src/db/seedCatalog.js",
    "db:setup": "node src/db/migrateAndSeed.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
