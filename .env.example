# Hôm nay ăn gì · Taste of Vietnam v0.2 — Production Environment Template
# Copy this file to .env and fill in your keys

# ── Server & Runtime ──────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ── Gemini 2.0 Flash AI (M3-S04 & NLU) ────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# Leave blank to run in high-speed fallback mode (local regex/dictionary NLU)
GEMINI_API_KEY=

# ── PostgreSQL & PostGIS Spatial Database ─────────────────────────────────────
# Provision via Render Postgres, Supabase, Neon, or Docker Compose (needs PostGIS).
# Set  -> accounts, profiles, history, catalogue, payments are stored in Postgres.
#         First run `npm run db:migrate` (+ `npm run db:seed` for the demo catalogue):
#         the server refuses to start while migrations are pending.
# Empty -> in-memory store (dev/tests only): everything is lost on restart.
DATABASE_URL=postgresql://tov_user:tov_secret_password@localhost:5432/taste_of_vietnam
# true = apply pending migrations automatically at boot, and load the demo catalogue if the
# dishes table is empty (insert-only). docker-compose uses this; Render free plan has no shell, so set it there.
DB_AUTO_MIGRATE=false
# Guest accounts older than this many days are deleted (default 30)
GUEST_TTL_DAYS=30
# Only for `npm run test:db`: a THROWAWAY database (its public schema is dropped on every run)
# TEST_DATABASE_URL=postgresql://tov:tov@localhost:5432/tov_test
# REDIS_URL=redis://localhost:6379

# ── VietQR & PayOS Payment Gateway (M7 Ad Top-up & M20 Community Tipping) ─────
# Register at: https://payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
# REQUIRED to accept payments: the webhook verifies PayOS's HMAC-SHA256 signature with this key.
# Empty => /api/v1/payments/webhook rejects everything (no money is ever credited).
PAYOS_CHECKSUM_KEY=
# Register this URL as the webhook in the PayOS dashboard
PAYOS_WEBHOOK_URL=https://taste-of-vietnam.onrender.com/api/v1/payments/webhook

# ── Auth (M1): phone OTP + signed tokens ──────────────────────────────────────
# REQUIRED in production: secret that signs login tokens (any long random string,
# e.g. `openssl rand -hex 32`). If empty a random one is made at boot and every
# user is logged out on each restart.
JWT_SECRET=
# Bootstrap FIRST super_admin only, after verified login (comma-separated 09xx/+849xx).
# Once a super_admin exists, grant/revoke roles through /admin/rbac/users, not env.
# ADMIN_EMAILS is read by the Google login stream only after verifying the email.
# Keep REPORT_IDENTITY_KEY stable for the reporting HMAC even when JWT_SECRET rotates.
# Without it reporting uses JWT_SECRET; rotating BOTH resets dedupe identities for 24h.
REPORT_IDENTITY_KEY=
# Existing merchant bootstrap (M6 frozen):
ADMIN_PHONES=
MERCHANT_PHONES=
# OTP SMS via eSMS.vn. Without both keys: dev mode (NODE_ENV != production) logs the
# code and returns it in the API response; production refuses phone login (guest still works).
SMS_API_KEY=
SMS_SECRET_KEY=
# Registered eSMS brandname (optional; without it a non-brandname route is used)
SMS_BRANDNAME=

# ── Push Notifications (M8 — SLA max 2/day) ───────────────────────────────────
# FCM_SERVER_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=

# ── Health Wearables & IoT Sensor Sync (M18, M19) ─────────────────────────────
APPLE_HEALTH_SYNC_ENABLED=true
GOOGLE_FIT_SYNC_ENABLED=true
IOT_FRIDGE_SCANNER_ENABLED=true

# ── Maps & GPS Verification (M4 3km search & M12 GPS 500m review guard) ───────
# GOOGLE_MAPS_KEY=
# GOONG_API_KEY=

# ── Delivery Partner Deep-Links (M5 4-Action Hub) ─────────────────────────────
GRAB_PARTNER_ID=homnayan_gi_mvp
SHOPEEFOOD_PARTNER_ID=homnayan_gi_mvp
BEFOOD_PARTNER_ID=homnayan_gi_mvp

# ── PDPD Compliance (Nghị định 13/2023/NĐ-CP) ────────────────────────────────
PDPD_CONSENT_REQUIRED=true
DATA_DELETION_WEBHOOK_URL=
DPA_CONTACT_EMAIL=dpa@tastevietnam.vn

# Optional internal design tool. /studio is disabled without this, in all environments.
# Use HTTPS; browser Basic Auth username can be "studio". This is not an app login.
STUDIO_PASSWORD=
