# Hôm nay ăn gì · Taste of Vietnam v0.1 — Environment Template
# Copy this file to .env and fill in your keys

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# Leave blank to run in fallback mode (uses local Vietnamese NLU)
GEMINI_API_KEY=

# ── Database (optional — currently uses in-memory seed data) ──────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/taste_of_vietnam
# REDIS_URL=redis://localhost:6379

# ── Push Notifications (M8 — max 2/day) ──────────────────────────────────────
# FCM_SERVER_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=

# ── Maps & GPS (M4, M12 GPS 500m review guard) ───────────────────────────────
# GOOGLE_MAPS_KEY=
# GOONG_API_KEY=

# ── Payment / Ordering (M5 deep-link partners) ───────────────────────────────
# GRAB_PARTNER_ID=
# BAEMIN_PARTNER_ID=
# SHOPEEFOOD_PARTNER_ID=

# ── Analytics & Ad fraud (M7 60s dedup) ──────────────────────────────────────
# AMPLITUDE_API_KEY=
# ADJUST_APP_TOKEN=

# ── PDPD Compliance (Nghị định 13/2023/NĐ-CP) ────────────────────────────────
# DATA_DELETION_WEBHOOK_URL=
# DPA_CONTACT_EMAIL=dpa@tastevietnam.vn
